# Supabase (Settings → API Keys). Región UE (Fráncfort).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Solo servidor. Nunca en el navegador.
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública de la app (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend. Sin clave, los emails se escriben en la consola (modo desarrollo).
RESEND_API_KEY=
# Debe ser un dominio verificado en la cuenta Resend de FByte.
EMAIL_FROM="Mesa <no-responder@fbytesolutions.com>"

# Solo para pruebas e2e (superadmin creado con pnpm admin:create)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
